{
  "name": "zab-cv",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Online CV of Nektarios Zabouris: content.env → online page, one-page A4 sheet and PDF",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:pdf": "node scripts/build.mjs --pdf",
    "watch": "node scripts/build.mjs --watch",
    "serve": "node scripts/serve.mjs dist 5500",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "sass": "^1.80.0"
  }
}
