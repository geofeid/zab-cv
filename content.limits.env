# Default max applies to every property unless a key has an explicit override.
# Every cap is checked against BOTH the online values and the merged print values.
DEFAULT_MAX=90

# Long-form online and print copy. Generic keys cover every numbered entry:
# EXP_DESC1 caps EXP1_DESC1..EXP5_DESC1, EXP_DESC caps each print EXPn_DESC,
# PROJ_DESC caps PROJ1_DESC..PROJ7_DESC. These are backstops, not the print
# budgets: the sheet wants ABOUT <= 380, EXPn_DESC <= 300/220/110 and
# PROJn_DESC <= 95 (see content.print.env).
ABOUT_PARAGRAPH=700
EXP_DESC1=260
EXP_DESC2=260
EXP_DESC3=260
EXP_DESC4=260
EXP_DESC=300
PROJ_DESC=230

# Education and certification details
EDU_TITLE=120
EDU_DESC=120
CERT_DESC1=140
